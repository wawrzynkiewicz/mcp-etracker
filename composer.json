{
    "name": "ibexa/mcp-etracker",
    "description": "Simulated etracker MCP service: exposes website and Instagram click-stream statistics as MCP tools.",
    "license": "proprietary",
    "type": "ibexa-bundle",
    "keywords": [
        "ibexa-dxp",
        "mcp",
        "etracker"
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://updates.ibexa.co"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-json": "*",
        "ibexa/mcp": "^5.0",
        "mcp/sdk": "^0.7.1",
        "symfony/config": "^7.4 || ^8.1",
        "symfony/dependency-injection": "^7.4 || ^8.1",
        "symfony/http-kernel": "^7.4 || ^8.1"
    },
    "require-dev": {
        "deptrac/deptrac": "^3.0",
        "ibexa/code-style": "~2.1.0",
        "ibexa/phpstan": "~6.0.x-dev",
        "ibexa/rector": "~6.0.x-dev",
        "matthiasnoback/symfony-dependency-injection-test": "^6.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/phpunit-bridge": "^7.4 || ^8.1"
    },
    "autoload": {
        "psr-4": {
            "Ibexa\\Bundle\\McpEtracker\\": "src/bundle/",
            "Ibexa\\Contracts\\McpEtracker\\": "src/contracts/",
            "Ibexa\\McpEtracker\\": "src/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ibexa\\Tests\\Bundle\\McpEtracker\\": "tests/bundle/",
            "Ibexa\\Tests\\McpEtracker\\": "tests/lib/"
        }
    },
    "scripts": {
        "fix-cs": "php-cs-fixer fix --config=.php-cs-fixer.php --show-progress=dots",
        "check-cs": "@fix-cs --dry-run",
        "test": "phpunit -c phpunit.xml.dist",
        "phpstan": "phpstan analyse -c phpstan.neon",
        "deptrac": "php vendor/bin/deptrac analyse"
    },
    "scripts-descriptions": {
        "fix-cs": "Automatically fixes code style in all files",
        "check-cs": "Run code style checker for all files",
        "test": "Run automatic tests",
        "phpstan": "Run static code analysis",
        "deptrac": "Run Deptrac architecture testing"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.0.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    }
}
